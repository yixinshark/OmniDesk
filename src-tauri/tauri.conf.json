{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tauri-app",
  "version": "0.1.0",
  "identifier": "com.ut005025.tauri-app",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Widget Desktop",
        "width": 1280,
        "height": 720,
        "maximized": true,
        "decorations": false,
        "transparent": true,
        "fullscreen": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../public/widgets/": "widgets/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/systemd/user/tauri-app.service": "systemd/tauri-app.service"
        },
        "postInstallScript": "deb/postinst",
        "preRemoveScript": "deb/prerm",
        "postRemoveScript": "deb/postrm"
      }
    }
  }
}
